<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>stockflow-dbdeploy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StockFlow.Data\StockFlow.Data.csproj" />
  </ItemGroup>

  <!-- Ship the SQL scripts next to the tool so a release folder is self-contained. -->
  <ItemGroup>
    <None Include="..\..\database\**\*.sql" LinkBase="database" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
