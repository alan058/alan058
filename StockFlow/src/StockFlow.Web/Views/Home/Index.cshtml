@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Summary;
}
<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2"><div class="card stat"><div class="card-body"><div class="stat-label">Active products</div><div class="stat-value">@s.ActiveProducts</div></div></div></div>
    <div class="col-6 col-lg-2">
        <a class="card stat text-decoration-none @(s.LowStockProducts > 0 ? "border-danger" : "")" asp-controller="Reports" asp-action="LowStock">
            <div class="card-body"><div class="stat-label">Low stock</div><div class="stat-value @(s.LowStockProducts > 0 ? "text-danger" : "")">@s.LowStockProducts</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-2"><a class="card stat text-decoration-none" asp-controller="Orders" asp-action="Index" asp-route-status="Open"><div class="card-body"><div class="stat-label">Open orders</div><div class="stat-value">@s.OpenOrders</div></div></a></div>
    <div class="col-6 col-lg-2"><a class="card stat text-decoration-none" asp-controller="Orders" asp-action="Index" asp-route-status="Allocated"><div class="card-body"><div class="stat-label">Ready to dispatch</div><div class="stat-value">@s.AllocatedOrders</div></div></a></div>
    <div class="col-6 col-lg-2"><div class="card stat"><div class="card-body"><div class="stat-label">Dispatched today</div><div class="stat-value">@s.DispatchedToday</div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card stat"><div class="card-body"><div class="stat-label">Stock value (R)</div><div class="stat-value fs-5">@HtmlExtensions.Money(s.StockValue)</div></div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-baseline">
            <h2 class="h5">Recent orders</h2>
            <a asp-controller="Orders" asp-action="Index">All orders</a>
        </div>
        <table class="table table-sm table-hover align-middle">
            <thead><tr><th>Order</th><th>Customer</th><th>From</th><th>Status</th><th class="text-end">Value (R)</th></tr></thead>
            <tbody>
                @foreach (var o in Model.RecentOrders)
                {
                    <tr>
                        <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.SalesOrderId">@o.OrderNumber</a></td>
                        <td>@o.CustomerName</td>
                        <td>@o.WarehouseCode</td>
                        <td>@Html.StatusBadge(o.Status)</td>
                        <td class="text-end">@HtmlExtensions.Money(o.TotalValue)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-lg-5">
        <div class="d-flex justify-content-between align-items-baseline">
            <h2 class="h5">Needs reordering</h2>
            <a asp-controller="Reports" asp-action="LowStock">Full report</a>
        </div>
        @if (Model.LowStock.Count == 0)
        {
            <p class="text-muted">Nothing is below its reorder level.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>SKU</th><th>Product</th><th class="text-end">Available</th><th class="text-end">Reorder at</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.LowStock)
                    {
                        <tr>
                            <td><a asp-controller="Products" asp-action="Details" asp-route-id="@i.ProductId">@i.Sku</a></td>
                            <td>@i.Name</td>
                            <td class="text-end text-danger fw-semibold">@i.QuantityAvailable</td>
                            <td class="text-end">@i.ReorderLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
