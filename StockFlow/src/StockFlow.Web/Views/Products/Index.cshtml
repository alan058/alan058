@model ProductIndexViewModel
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" asp-action="Create">Add product</a>
</div>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-md-4"><input class="form-control" name="q" value="@Model.Q" placeholder="Search SKU or name" aria-label="Search" /></div>
    <div class="col-md-3">
        <select class="form-select" name="categoryId" asp-items="Model.Categories" aria-label="Category">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" id="lowStock" name="lowStock" value="true" @(Model.LowStock ? "checked" : "") />
        <label class="form-check-label" for="lowStock">Low stock only</label>
    </div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" @(Model.IncludeInactive ? "checked" : "") />
        <label class="form-check-label" for="includeInactive">Include inactive</label>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Filter</button></div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>SKU</th><th>Name</th><th>Category</th>
            <th class="text-end">Price (R)</th><th class="text-end">On hand</th><th class="text-end">Reserved</th>
            <th class="text-end">Available</th><th class="text-end">Reorder at</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr class="@(p.IsActive ? "" : "text-muted")">
                <td><a asp-action="Details" asp-route-id="@p.ProductId">@p.Sku</a></td>
                <td>@p.Name @if (!p.IsActive) { <span class="badge text-bg-light">inactive</span> }</td>
                <td>@p.CategoryName</td>
                <td class="text-end">@HtmlExtensions.Money(p.UnitPrice)</td>
                <td class="text-end">@p.QuantityOnHand</td>
                <td class="text-end">@p.QuantityReserved</td>
                <td class="text-end @(p.IsLowStock ? "text-danger fw-semibold" : "")">@p.QuantityAvailable</td>
                <td class="text-end">@p.ReorderLevel</td>
            </tr>
        }
    </tbody>
</table>
@if (Model.Products.Count == 0)
{
    <p class="text-muted">No products match the filter.</p>
}
