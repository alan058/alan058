@model OrderCreateViewModel
@{
    ViewData["Title"] = "New order";
}
<h1 class="h3 mb-3">New sales order</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="alert alert-danger empty-hidden"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label asp-for="CustomerId" class="form-label"></label>
            <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select"><option value="0">Choose…</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="WarehouseId" class="form-label"></label>
            <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="0">Choose…</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="RequiredDate" class="form-label"></label>
            <input asp-for="RequiredDate" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" />
        </div>
    </div>

    <h2 class="h5">Lines</h2>
    <p class="small text-muted">Availability shown is the total across all warehouses. Leave rows blank if you don't need them. The same product on two rows is combined into one line.</p>
    <table class="table table-sm align-middle" id="lines">
        <thead><tr><th>Product</th><th style="width: 9rem">Quantity</th></tr></thead>
        <tbody>
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td><select asp-for="Lines[i].ProductId" asp-items="Model.Products" class="form-select form-select-sm"><option value="0"></option></select></td>
                    <td><input asp-for="Lines[i].Quantity" class="form-control form-control-sm" type="number" min="0" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-secondary mb-4" id="addLine">Add line</button>

    <div>
        <button type="submit" class="btn btn-primary">Create order</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Adds another line by cloning the last row and renumbering its field names.
        document.getElementById('addLine').addEventListener('click', function () {
            const body = document.querySelector('#lines tbody');
            const index = body.rows.length;
            const row = body.rows[body.rows.length - 1].cloneNode(true);
            row.querySelectorAll('select, input').forEach(function (el) {
                el.name = el.name.replace(/Lines\[\d+\]/, 'Lines[' + index + ']');
                el.id = el.id.replace(/Lines_\d+__/, 'Lines_' + index + '__');
                el.value = el.tagName === 'SELECT' ? '0' : '';
            });
            body.appendChild(row);
        });
    </script>
}
